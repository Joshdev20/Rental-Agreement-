# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your deployment.
# ---------------------------------------------------------------------------

# Port the web server listens on.
PORT=12000

# Secret used to sign admin session cookies. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin account. Seeded on first boot when no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Property Manager

# Where the SQLite database and generated PDFs live.
DATA_DIR=./data

# Address that receives "new submission" notifications.
ADMIN_NOTIFY_EMAIL=admin@example.com

# ---- Optional e-mail notifications (SMTP) ---------------------------------
# Leave SMTP_HOST empty to disable e-mail. Notifications are always recorded
# in the admin dashboard and can be forwarded to a webhook instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rental Agreement Desk <no-reply@example.com>"

# ---- Optional webhook notification (Slack/Zapier/Make/n8n/...) -----------
# Receives a JSON POST body with the submission summary.
NOTIFY_WEBHOOK_URL=
